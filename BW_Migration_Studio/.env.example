# HanaMorph BW Migration Studio - Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS. Copy to .env for local overrides.

# Studio Server Configuration
PORT=4004
HOST=localhost
NODE_ENV=development
LOG_LEVEL=info

# Persistence Configuration
DB_KIND=sqlite
SQLITE_DB_PATH=bw-studio/database/bw_studio.sqlite

# SAP S21 BW Read-Only Connection (Reference / Mock Mode)
S21_HOST=s21.corp.internal
S21_CLIENT=200
S21_SYSNR=00
S21_USER=int_samarth
# S21_PASSWORD=  <-- NEVER STORE PASSWORDS IN FILES; USE SECURE VAULT OR CLI PROMPT
S21_READ_ONLY=true
S21_USE_MOCK=true

# SAP Datasphere Configuration (Controlled Target Generation)
DATASPHERE_BASE_URL=https://your-tenant.eu10.hcs.cloud.sap
DATASPHERE_SPACE=SALES_ANALYTICS
DATASPHERE_CLIENT_ID=your-client-id
# DATASPHERE_CLIENT_SECRET= <-- STORE IN OS CREDENTIAL STORE
DATASPHERE_DRY_RUN=true
