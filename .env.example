# ==============================================================================
# HANAMORPH BW MIGRATION STUDIO — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and populate your environment-specific credentials.
# .env is strictly ignored by git to prevent accidental credential leakage.
# NEVER commit passwords, private keys, or service keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. STUDIO RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
STUDIO_PORT=4004
STUDIO_HOST=127.0.0.1
STUDIO_ENV=local_development
# Master encryption key (Base64 Fernet key). If empty, auto-generated in .master_key
MASTER_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 2. SAP BW S21 (NetWeaver AS ABAP & BW)
# ------------------------------------------------------------------------------
# Host IP or FQDN of the SAP S21 application server (Instance 00)
SAP_BW_HOST=192.168.1.55
SAP_BW_SYSNR=00
SAP_BW_CLIENT=200
SAP_BW_USER=int_samarth
SAP_BW_PASSWORD=your_s21_password_here
SAP_BW_HTTP_PORT=8000
SAP_BW_HTTPS_PORT=44300
SAP_BW_RFC_PORT=3300
SAP_BW_USE_HTTPS=false

# STRICT READ-ONLY SAFETY GUARDRAILS (HARD ENFORCED)
# Even when user has SAP_ALL, the studio rejects all mutating operations:
# - No POST/PUT/DELETE HTTP verbs (GET/HEAD only)
# - No DTP or Process Chain execution
# - No CTS Transport Request creation
# - No DDIC or Repository write/activate/delete
SAP_BW_STRICT_READ_ONLY=true
SAP_BW_ALLOW_SAP_ALL=true

# ------------------------------------------------------------------------------
# 3. SAP DATASPHERE (Data Warehouse Cloud)
# ------------------------------------------------------------------------------
# Full tenant URL or host (e.g. mytenant.eu10.datasphere.cloud.sap)
DATASPHERE_HOST=
DATASPHERE_SPACE=
# Authentication type: OAUTH2_CLIENT_CREDENTIALS (Recommended for API/CLI) or INTERACTIVE
DATASPHERE_AUTH_TYPE=OAUTH2_CLIENT_CREDENTIALS
# Obtain from: System -> Administration -> App Integration -> Add OAuth Client
DATASPHERE_OAUTH_TOKEN_URL=
DATASPHERE_OAUTH_CLIENT_ID=
DATASPHERE_OAUTH_CLIENT_SECRET=

# Interactive Web User (For documentation/reference; REST APIs require OAuth client)
DATASPHERE_USER=varad.k@abhiyantatech.com
DATASPHERE_PASSWORD=

# ------------------------------------------------------------------------------
# 4. SAP BTP (Business Technology Platform)
# ------------------------------------------------------------------------------
# Subaccount ID (GUID format) and region (e.g. eu10, us10)
BTP_SUBACCOUNT_ID=
BTP_REGION=eu10
# Preferred authentication: SERVICE_KEY or OAUTH (unattended automation)
BTP_AUTH_TYPE=SERVICE_KEY
BTP_SERVICE_KEY_PATH=secrets/btp-service-key.json
BTP_OAUTH_URL=
BTP_CLIENT_ID=
BTP_CLIENT_SECRET=

# Interactive User (For reference only; do not use personal password for automation)
BTP_USER=varad.k@abhiyantatech.com
BTP_PASSWORD=

# ------------------------------------------------------------------------------
# 5. SAP HANA CLOUD
# ------------------------------------------------------------------------------
# Endpoint hostname and SQL port (usually 443 for HANA Cloud)
HANA_CLOUD_HOST=
HANA_CLOUD_SQL_PORT=443
HANA_CLOUD_USER=
HANA_CLOUD_PASSWORD=
HANA_CLOUD_SCHEMA=
HANA_CLOUD_ENCRYPT=true
HANA_CLOUD_VALIDATE_CERT=true
# Hard-enforced session setting: SET TRANSACTION READ ONLY
HANA_STRICT_READ_ONLY=true

# ------------------------------------------------------------------------------
# 6. CLOUD FOUNDRY (BTP Runtime)
# ------------------------------------------------------------------------------
# Cloud Foundry API endpoint (e.g. https://api.cf.eu10.hana.ondemand.com)
CF_API_ENDPOINT=
CF_ORG=
CF_SPACE=
CF_AUTH_TYPE=SERVICE_KEY
CF_SERVICE_KEY_PATH=secrets/cf-service-key.json
CF_CLIENT_ID=
CF_CLIENT_SECRET=
CF_USER=varad.k@abhiyantatech.com
CF_PASSWORD=
